# Names only. Do not put credentials in this template or Git.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=
# Future ingestion worker: NO GitHub token and NO Supabase service-role key.
# Only https://www.googleapis.com/auth/drive.readonly is accepted.
GOOGLE_DRIVE_ACCESS_TOKEN=
# Optional absolute path to an operator-installed pdftotext binary.
PDFTOTEXT_BIN=
# Phase 3B: NO_API. Interactive Codex work packages need no AI credentials.
# The dormant API provider is not connected to either ingestion CLI.
# A dedicated AGENT session only; never a human or service-role session.
TSSR_AGENT_SESSION=
